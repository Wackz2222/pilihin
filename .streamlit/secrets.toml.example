# Salin file ini menjadi secrets.toml lalu isi API key Anda.
# API key gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY = "isi-api-key-anda"

# Opsional
GEMINI_MODEL = "gemini-flash-latest"   # contoh lain: gemini-2.5-flash, gemini-2.5-pro
GEMINI_SEARCH = "true"                 # "false" untuk mematikan cek harga via Google Search
